{
  "name": "doyban",
  "version": "2.0.2",
  "private": true,
  "scripts": {
    "build": "nuxi build",
    "dev": "nuxi dev",
    "generate": "nuxi generate",
    "preview": "nuxi preview",
    "postinstall": "nuxi prepare",
    "start": "nuxi preview",
    "lint:js": "eslint --ext .js,.vue --ignore-path .gitignore .",
    "lint:style": "stylelint **/*.{vue,css} --ignore-path .gitignore",
    "lint": "yarn lint:js && yarn lint:style",
    "test": "jest",
    "serve": "firebase serve --only functions,hosting",
    "deploy": "firebase deploy",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal public/logo.svg"
  },
  "lint-staged": {
    "*.{js,vue}": "eslint",
    "*.{css,vue}": "stylelint"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-commit": "lint-staged"
    }
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-recaptcha-v3": "^2.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@mdi/font": "^7.4.47",
    "@nuxtjs/eslint-config-typescript": "^12.1.0",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@nuxtjs/robots": "^7.0.2",
    "@nuxtjs/sitemap": "^9.1.0",
    "@nuxtjs/stylelint-module": "^5.2.1",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vuetify": "^2.7.3",
    "firebase-functions-test": "^3.5.0",
    "husky": "^4.3.8",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "nuxt": "^4.6.2",
    "nuxt-mail": "^9.0.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "sass": "^1.106.1",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "sweetalert2": "^11.26.25",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "vue-jest": "^3.0.7",
    "vuetify": "^4.3.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
